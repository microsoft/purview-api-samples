# ---- Microsoft Entra ID (used by the Lambda for OBO -> Microsoft Graph) ----
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# ---- Amazon Bedrock ----
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v2:0

# AWS credentials are picked up from the Lambda execution role at runtime.
# For local testing only, you can use the standard boto3 provider chain
# (env vars, ~/.aws/credentials, or AWS_PROFILE).
